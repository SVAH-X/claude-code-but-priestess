{
  "name": "prts-vscode",
  "displayName": "PRTS — Priestess Chat Companion",
  "version": "0.7.6",
  "description": "Chat with Priestess (Arknights) inside VS Code, backed by your local Claude Code / Codex CLI via the PRTS tray app.",
  "publisher": "svah-x",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SVAH-X/claude-code-but-priestess"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prts.sendSelection",
        "title": "PRTS: Send Selection to Priestess",
        "icon": "$(send)"
      },
      {
        "command": "prts.openChat",
        "title": "PRTS: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "prts.newConversation",
        "title": "PRTS: Start New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "prts.restoreConversation",
        "title": "PRTS: Restore Previous Conversation",
        "icon": "$(history)"
      },
      {
        "command": "prts.toggleVibeCoding",
        "title": "PRTS: Toggle Vibe Coding Mode (陪伴 ↔ 顾问)",
        "icon": "$(sync)"
      },
      {
        "command": "prts.showContextInfo",
        "title": "PRTS: Show Editor Context Info",
        "icon": "$(info)"
      },
      {
        "command": "prts.suggestFix",
        "title": "PRTS: Suggest Fix for Selected Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "prts.explainError",
        "title": "PRTS: Explain Error at Cursor",
        "icon": "$(question)"
      },
      {
        "command": "prts.reviewFile",
        "title": "PRTS: Review Current File",
        "icon": "$(search)"
      },
      {
        "command": "prts.summarizeChanges",
        "title": "PRTS: Summarize Recent Git Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "prts.generateTests",
        "title": "PRTS: Generate Tests for Selected Code",
        "icon": "$(beaker)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prts-sidebar",
          "title": "PRTS",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "prts-sidebar": [
        {
          "type": "webview",
          "id": "prts.chatView",
          "name": "PRTS"
        }
      ]
    },
    "submenus": [
      {
        "id": "prts.editorContext",
        "label": "PRTS"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "prts.editorContext",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "prts.editorContext",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "prts.openChat",
          "group": "navigation@9"
        }
      ],
      "prts.editorContext": [
        {
          "command": "prts.sendSelection",
          "when": "editorHasSelection",
          "group": "1_send@1"
        },
        {
          "command": "prts.showContextInfo",
          "when": "editorTextFocus",
          "group": "2_info@1"
        },
        {
          "command": "prts.toggleVibeCoding",
          "group": "3_mode@1"
        },
        {
          "command": "prts.suggestFix",
          "when": "editorTextFocus",
          "group": "4_fix@1"
        },
        {
          "command": "prts.explainError",
          "when": "editorTextFocus",
          "group": "4_fix@2"
        },
        {
          "command": "prts.reviewFile",
          "when": "editorTextFocus",
          "group": "4_fix@3"
        }
      ],
      "commandPalette": [
        {
          "command": "prts.sendSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "prts.showContextInfo",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "prts.sendSelection",
        "key": "ctrl+shift+alt+s",
        "when": "editorHasSelection"
      },
      {
        "command": "prts.toggleVibeCoding",
        "key": "ctrl+shift+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "prts.explainError",
        "key": "ctrl+shift+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "prts.reviewFile",
        "key": "ctrl+shift+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "prts.summarizeChanges",
        "key": "ctrl+shift+alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "prts.generateTests",
        "key": "ctrl+shift+alt+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "PRTS",
      "properties": {
        "prts.electronPort": {
          "type": "number",
          "default": 0,
          "description": "WebSocket port of the PRTS Electron app. Auto-detected from ws-port.json at startup; set manually only if auto-detection fails."
        },
        "prts.advisorFileBlacklist": {
          "type": "string",
          "default": ".env\n.env.*\n*secret*\n*credential*\n*.pem\n*.key\nid_rsa*\n*password*\n*token*",
          "description": "Prompt the model to avoid reading files matching these patterns (gitignore-style, one per line). This is a model-prompt constraint, not a filesystem security guarantee."
        }
      }
    }
  },
  "scripts": {
    "vscode:compile": "tsc -p ./",
    "vscode:watch": "tsc -watch -p ./",
    "vscode:package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run test:unit && npm run test:integration",
    "test:compile": "tsc -p ./",
    "test:unit": "tsc -p ./ && mocha \"out/src/test/unit/**/*.test.js\" --require ./out/src/test/unit/helpers/vscode-stub.js --ui bdd --timeout 20000",
    "test:integration": "tsc -p ./ && node ./out/src/test/runTest.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "diff": "^5.2.0"
  }
}
